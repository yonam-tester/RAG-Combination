# AI Analysis Server URL
# rag_server or llm_server (FastAPI): http://localhost:8000
AI_SERVER_URL=http://localhost:8000

# LLM Provider (openai | bedrock)
# Default: openai
LLM_PROVIDER=openai

# Required when LLM_PROVIDER=openai (OpenAI / LiteLLM / Anthropic proxy)
LLM_API_KEY=

# Optional: LLM endpoint URL (default: https://api.openai.com/v1)
# Change to your LiteLLM proxy URL if using a proxy
# LLM_BASE_URL=http://localhost:4000/v1

# Optional: Model name (default: gpt-4o)
# LLM_MODEL=gpt-4o

# Required when LLM_PROVIDER=bedrock
# AWS_REGION=us-east-1
# AWS_BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
