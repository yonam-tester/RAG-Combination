# ──────────────────────────────────────────────
# 백엔드 → AI 서버 연결
# ──────────────────────────────────────────────
AI_SERVER_URL=http://rag-server:8000

# ──────────────────────────────────────────────
# LLM 공급자 설정
# openai | bedrock
# ──────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_API_KEY=
# LLM_MODEL=gpt-4o
# LLM_BASE_URL=https://api.openai.com/v1

# ──────────────────────────────────────────────
# AWS (Bedrock 사용 시)
# EC2 IAM Role 사용 시 KEY/SECRET 비워두면 자동 인증
# ──────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ──────────────────────────────────────────────
# S3 스토리지
# MinIO 로컬: http://minio:9000
# 실제 AWS S3: 값 비워두면 SDK 기본 엔드포인트 사용
# ──────────────────────────────────────────────
AWS_S3_ENDPOINT=http://minio:9000
AWS_S3_ACCESS_KEY=minioadmin
AWS_S3_SECRET_KEY=minioadmin
AWS_S3_BUCKET_DOCUMENTS=yeonam-documents
AWS_S3_BUCKET_REPORTS=yeonam-reports

# ──────────────────────────────────────────────
# RAG 서버 S3 설정 (rag-server boto3가 직접 읽는 값)
# ──────────────────────────────────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=yeonam-documents

# ──────────────────────────────────────────────
# RAG 서버 설정
# ──────────────────────────────────────────────
MOCK_LLM=false
MOCK_RAG=false
BACKEND_URL=http://backend:8080
